# AnyCursor service environment.
#
# Keep this file 0600 and owned by anycursor. It is read by
# anycursor.service through EnvironmentFile=.
#
# Remote access requires a non-empty token. Generate one with:
#   openssl rand -hex 32
# and set gateway.host to a private interface or 0.0.0.0 in config.json.
ANY_CURSOR_ACCESS_TOKEN=

# Public URL used by the dashboard and Cursor clients, for example
# https://anycursor.example.com. Leave empty for loopback-only use.
ANY_CURSOR_PUBLIC_URL=

# Provider credentials referenced by ${...} placeholders in config.json.
# Uncomment and fill only the providers you use.
# OPENCODE_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
