{
  "name": "anycursor",
  "displayName": "AnyCursor",
  "description": "Use Cursor's native models and your own BYOK models side by side.",
  "version": "0.2.1",
  "publisher": "anycursor",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anycursor.openSettings",
        "title": "AnyCursor: Open Settings"
      },
      {
        "command": "anycursor.openConfigFile",
        "title": "AnyCursor: Open Configuration File"
      },
      {
        "command": "anycursor.doctor",
        "title": "AnyCursor: Doctor"
      },
      {
        "command": "anycursor.startGateway",
        "title": "AnyCursor: Start Gateway"
      },
      {
        "command": "anycursor.repairShortcuts",
        "title": "AnyCursor: Repair Cursor Shortcuts"
      }
    ]
  },
  "scripts": {
    "package": "vsce package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DvX777/Anycursor.git"
  },
  "homepage": "https://github.com/DvX777/Anycursor",
  "bugs": {
    "url": "https://github.com/DvX777/Anycursor/issues"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
