{
  "name": "anycursor",
  "displayName": "AnyCursor",
  "description": "Bring your own BYOK models into Cursor's native Agent, tools, MCP, subagents and approvals through a local gateway.",
  "version": "0.3.1",
  "publisher": "anycursor",
  "license": "MIT",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#f5f7fb",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "cursor",
    "byok",
    "llm",
    "gateway",
    "openai",
    "anthropic",
    "bedrock",
    "local"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anycursor.openSettings",
        "title": "AnyCursor: Open Settings"
      },
      {
        "command": "anycursor.openConfigFile",
        "title": "AnyCursor: Open Configuration File"
      },
      {
        "command": "anycursor.doctor",
        "title": "AnyCursor: Doctor"
      },
      {
        "command": "anycursor.startGateway",
        "title": "AnyCursor: Start Gateway"
      },
      {
        "command": "anycursor.repairShortcuts",
        "title": "AnyCursor: Repair Cursor Shortcuts"
      }
    ]
  },
  "scripts": {
    "package": "vsce package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DvX777/Anycursor.git"
  },
  "homepage": "https://github.com/DvX777/Anycursor",
  "bugs": {
    "url": "https://github.com/DvX777/Anycursor/issues"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
