{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anycursor.dev/schema/anycursor.schema.json",
  "title": "AnyCursor configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providers",
    "models"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataDir": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "default": "127.0.0.1"
        },
        "logLevel": {
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 43110
        },
        "publicUrl": {
          "type": "string",
          "description": "Externally reachable base URL, for example https://anycursor.example.com. Used for Cursor routing and the dashboard."
        },
        "accessToken": {
          "type": "string",
          "description": "Bearer token required for dashboard, API and non-private clients. Use ${ENV_VAR} on servers."
        },
        "allowInsecureRemote": {
          "type": "boolean",
          "default": false,
          "description": "Allow a public bind without an accessToken. Only behind another network control."
        },
        "trustPrivateNetworks": {
          "type": "boolean",
          "default": true,
          "description": "Treat loopback, RFC1918, Tailscale and ULA addresses as trusted without a token."
        },
        "grants": {
          "type": "array",
          "description": "Scoped access grants. Tokens are stored as SHA-256 hashes; owner is the accessToken.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "tokenHash"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "role": { "enum": ["admin", "viewer", "client"] },
              "tokenHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "createdAt": { "type": "string" },
              "expiresAt": { "type": "string" }
            }
          }
        },
        "upstream": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backendUrl": {
          "type": "string"
        },
        "supervise": {
          "type": "boolean",
          "default": true,
          "description": "Start and supervise a local gateway. Set false when Cursor points at a remote gateway."
        },
        "modelIdPrefix": {
          "type": "string",
          "default": "claude-anycursor",
          "description": "Prefix for generated Cursor model ids. Keep it out of Cursor BYOK classification; set empty for the legacy anycursor/ namespace."
        },
        "patchShortcuts": {
          "type": "boolean",
          "default": true
        },
        "restartPolicy": {
          "enum": [
            "ask",
            "reload",
            "never"
          ],
          "default": "ask"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nativePassthrough": {
          "type": "boolean",
          "default": true
        },
        "onUnknownModel": {
          "enum": [
            "native",
            "error"
          ],
          "default": "native"
        },
        "defaultModel": {
          "type": "string"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockTelemetry": {
          "type": "boolean",
          "default": true,
          "description": "Refuse to forward Cursor analytics, metrics, traces and log uploads. Inference, catalog, auth and dashboard calls are never blocked. Blocked requests receive an empty success response and are logged by path only."
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "accessKeyId": {
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          },
          "apiKeyRef": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "credential": {
            "type": "string",
            "description": "Reuse a credential from a local integration, e.g. opencode-go."
          },
          "deployment": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "modelsDevProvider": {
            "type": "string"
          },
          "query": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "region": {
            "type": "string"
          },
          "secretAccessKey": {
            "type": "string"
          },
          "secretAccessKeyRef": {
            "type": "string"
          },
          "sessionToken": {
            "type": "string"
          },
          "sessionTokenRef": {
            "type": "string"
          },
          "type": {
            "enum": [
              "openai-compatible",
              "anthropic",
              "google",
              "azure-openai",
              "bedrock"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "displayName",
          "provider",
          "model"
        ],
        "additionalProperties": false,
        "properties": {
          "api": {
            "enum": [
              "openai-compatible",
              "anthropic",
              "google",
              "azure-openai",
              "bedrock"
            ]
          },
          "apiKey": {
            "type": "string"
          },
          "apiKeyRef": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tools": {
                "type": "boolean"
              },
              "vision": {
                "type": "boolean"
              },
              "reasoning": {
                "type": "boolean"
              },
              "streaming": {
                "type": "boolean"
              },
              "cache": {
                "type": "boolean"
              }
            }
          },
          "contextOptions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "integer"
                }
              }
            }
          },
          "contextWindow": {
            "type": "integer",
            "minimum": 1
          },
          "cursorId": {
            "type": "string",
            "description": "Exact Cursor model id. Use a non-BYOK prefix such as claude-anycursor- to keep Cursor on the local loop."
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "object",
            "required": [
              "tiers",
              "default"
            ],
            "properties": {
              "tiers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "value": {}
                  }
                }
              },
              "default": {
                "type": "string"
              },
              "requestField": {
                "type": "string"
              }
            }
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "endpoint": {
            "type": "string"
          },
          "fast": {
            "type": "boolean",
            "default": false
          },
          "id": {
            "type": "string"
          },
          "legacyIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxOutput": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer"
          },
          "pricing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cacheRead": {
                "type": "number",
                "minimum": 0
              },
              "cacheWrite": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "provider": {
            "type": "string"
          },
          "providerLabel": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          }
        }
      }
    }
  }
}
