{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anycursor.dev/schema/anycursor.schema.json",
  "title": "AnyCursor configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providers",
    "models"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataDir": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "default": "127.0.0.1"
        },
        "logLevel": {
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 43110
        },
        "upstream": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backendUrl": {
          "type": "string"
        },
        "restartPolicy": {
          "enum": [
            "ask",
            "reload",
            "never"
          ],
          "default": "ask"
        },
        "patchShortcuts": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nativePassthrough": {
          "type": "boolean",
          "default": true
        },
        "onUnknownModel": {
          "enum": [
            "native",
            "error"
          ],
          "default": "native"
        },
        "defaultModel": {
          "type": "string"
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "accessKeyId": {
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          },
          "apiKeyRef": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "credential": {
            "type": "string",
            "description": "Reuse a credential from a local integration, e.g. opencode-go."
          },
          "deployment": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "modelsDevProvider": {
            "type": "string"
          },
          "query": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "region": {
            "type": "string"
          },
          "secretAccessKey": {
            "type": "string"
          },
          "secretAccessKeyRef": {
            "type": "string"
          },
          "sessionToken": {
            "type": "string"
          },
          "sessionTokenRef": {
            "type": "string"
          },
          "type": {
            "enum": [
              "openai-compatible",
              "anthropic",
              "google",
              "azure-openai",
              "bedrock"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "displayName",
          "provider",
          "model"
        ],
        "additionalProperties": false,
        "properties": {
          "api": {
            "enum": [
              "openai-compatible",
              "anthropic",
              "google",
              "azure-openai",
              "bedrock"
            ]
          },
          "apiKey": {
            "type": "string"
          },
          "apiKeyRef": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tools": {
                "type": "boolean"
              },
              "vision": {
                "type": "boolean"
              },
              "reasoning": {
                "type": "boolean"
              },
              "streaming": {
                "type": "boolean"
              },
              "cache": {
                "type": "boolean"
              }
            }
          },
          "contextOptions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "integer"
                }
              }
            }
          },
          "contextWindow": {
            "type": "integer",
            "minimum": 1
          },
          "cursorId": {
            "type": "string",
            "description": "Exact Cursor model id. Use a non-BYOK prefix such as claude-anycursor- to keep Cursor on the local loop."
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "object",
            "required": [
              "tiers",
              "default"
            ],
            "properties": {
              "tiers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "value": {}
                  }
                }
              },
              "default": {
                "type": "string"
              },
              "requestField": {
                "type": "string"
              }
            }
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "endpoint": {
            "type": "string"
          },
          "fast": {
            "type": "boolean",
            "default": false
          },
          "id": {
            "type": "string"
          },
          "legacyIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxOutput": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer"
          },
          "pricing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cacheRead": {
                "type": "number",
                "minimum": 0
              },
              "cacheWrite": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "provider": {
            "type": "string"
          },
          "providerLabel": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          }
        }
      }
    }
  }
}
