{
  "name": "anycursor",
  "version": "0.3.3",
  "private": true,
  "description": "Open-source model gateway and Cursor extension for BYOK models.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/gateway/index.js",
    "gateway": "node src/gateway/index.js",
    "discover": "node scripts/discover-models.js",
    "package:extension": "node scripts/stage-extension.js && cd extension && npx --yes @vscode/vsce package --no-dependencies",
    "install:windows": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "install:windows:admin": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1 -RequestAdmin",
    "repair:shortcuts": "powershell -ExecutionPolicy Bypass -File scripts/repair-shortcuts.ps1",
    "uninstall:windows": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1"
  }
}
